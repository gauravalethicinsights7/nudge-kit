# Copy to deploy/.env on the VM and fill in. Never commit the real file.
#
#   cp deploy/.env.example deploy/.env && nano deploy/.env

# ---- database (compose builds DATABASE_URL from these) ----
POSTGRES_USER=nudge
POSTGRES_DB=nudge
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Cloudflare Tunnel ----
# From the Cloudflare dashboard: Zero Trust > Networks > Tunnels > your tunnel
# > Install connector. Copy the long token out of the shown command.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- which frontend origins may call this API ----
# Your Cloudflare Pages production URL. Comma-separated for more than one.
CORS_ORIGINS=https://nudge-kit.pages.dev
# Pages gives every branch deploy its own hash subdomain, which can't be listed
# ahead of time. Leave this out if you only ever hit the production URL.
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.nudge-kit\.pages\.dev$

# ---- secrets ----
ANTHROPIC_API_KEY=
SERPER_API_KEY=
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
NUDGE_JWT_SECRET=

# ---- model / budget policy ----
NUDGE_RUN_BUDGET_USD=2.00
NUDGE_MODEL_TIER_FAST=claude-haiku-4-5-20251001
NUDGE_MODEL_TIER_STANDARD=claude-sonnet-5
NUDGE_MODEL_TIER_DEEP=claude-opus-5-5
