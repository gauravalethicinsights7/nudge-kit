# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://nudge:nudge@localhost:5432/nudge
ANTHROPIC_API_KEY=
# Serper (google.serper.dev) — free tier: 2,500 one-time credits, no card required.
SERPER_API_KEY=

# JWT signing secret for api/auth — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# A missing value falls back to an insecure dev-only default (api/auth/security.py) — never leave this unset in production.
NUDGE_JWT_SECRET=

# Per-run LLM budget cap in USD. Default is a dev placeholder — the real
# monthly cost cap / model tier policy is an open decision (see CLAUDE.md,
# owner: Ritesh). Raise or lower freely for local work.
NUDGE_RUN_BUDGET_USD=2.00

# Abstract tier -> concrete Anthropic model id. Provisional pending the
# provider/tier decision in CLAUDE.md; override any of these per environment.
NUDGE_MODEL_TIER_FAST=claude-haiku-4-5-20251001
NUDGE_MODEL_TIER_STANDARD=claude-sonnet-5
NUDGE_MODEL_TIER_DEEP=claude-opus-5-5
