# Base URL of the API. Vite inlines this at BUILD time, not at runtime — so
# changing it in the Cloudflare Pages dashboard requires a redeploy to take
# effect, not just a page refresh.
#
# Local dev leaves it unset and falls back to http://localhost:8000.
# In Cloudflare Pages set it as an environment variable on the project:
#   VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
